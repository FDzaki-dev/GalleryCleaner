    <!-- Batch67 (Audit Gap P2 #11, stage 1/4: OnboardingScreen.kt) -->
    <string name="onboarding_page1_title">Swipe to sort</string>
    <string name="onboarding_page1_body">Swipe right (or tap ✓) to keep a photo, swipe left (or tap ✕) to delete it. One decision at a time, no digging through folders.</string>
    <string name="onboarding_page2_title">Nothing\'s gone right away</string>
    <string name="onboarding_page2_body">Deleted photos go to Trash first, not straight off your device. You can restore them anytime, or set how long Trash keeps things in Settings.</string>
    <string name="onboarding_page3_title">Or clean in bulk</string>
    <string name="onboarding_page3_body">Inside any folder, switch to grid view to multi-select several photos at once instead of swiping one by one — handy for clearing out a whole album fast. Tap the zoom icon on any thumbnail to check it full-size before deciding.</string>
    <string name="onboarding_page4_title">Let the app find the junk</string>
    <string name="onboarding_page4_body">Home screen has scan buttons for blurry shots and near-duplicate burst photos — tap to scan, review what it finds, decide from there. Nothing runs in the background without you asking.</string>
    <string name="onboarding_page5_title">Shrink without deleting</string>
    <string name="onboarding_page5_body">Not ready to let a photo go? Select it in grid view and tap Compress to shrink the file size while keeping the photo looking the same.</string>
    <string name="onboarding_page6_title">A look back</string>
    <string name="onboarding_page6_body">\"On this day\" surfaces photos from this exact date in past years, right on the home screen — a nudge to revisit old memories, not just delete new clutter.</string>
    <string name="onboarding_page7_title">Find things fast</string>
    <string name="onboarding_page7_body">Use the search icon on the home screen to jump straight to a folder or a photo by name, instead of scrolling to find it.</string>
    <string name="onboarding_page8_title">Make it yours</string>
    <string name="onboarding_page8_body">Settings has a few color styles beyond the default look, plus a toggle for the short vibration when you swipe — on by default, easy to turn off.</string>
    <string name="onboarding_page9_title">Keep it private</string>
    <string name="onboarding_page9_body">If you\'d rather your gallery stay behind your phone\'s own lock screen, turn on App Lock in Settings — it uses whatever PIN, pattern, or biometric you already have set up.</string>
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_get_started">Get Started</string>
    <string name="onboarding_next">Next</string>

