<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ granular media permission -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Batch40 (Audit Gap P0 #1): video is now a real part of the scanned
         library (MediaDataSource queries MediaStore.Video.Media too), so
         this is requested alongside READ_MEDIA_IMAGES on API 33+. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Older Android versions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Only used if the user opts into the cleaning-reminder notification
         in Settings; requested at runtime on API 33+, never assumed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Swipe-decision haptic feedback (Settings toggle, default on). A
         *normal* permission — granted automatically at install, no runtime
         prompt, same as READ/WRITE_EXTERNAL_STORAGE above. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Batch39 (Audit Gap P0 #4): App Lock's BiometricPrompt. Normal
         permission, granted automatically at install — no runtime prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".GalleryCleanerApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.GalleryCleaner">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.GalleryCleaner.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>
